# Copy to /etc/pocketmm/pocketmm.env and fill on the server. Do not commit real secrets.
SPRING_PROFILES_ACTIVE=prod
PRIVATE_TEST_MODE=true
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
PROD_DB_URL=jdbc:mysql://127.0.0.1:3306/pocketmm
PROD_DB_USERNAME=pocketmm
PROD_DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
MAIL_USERNAME=
MAIL_PASSWORD=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Required: independently generated 32-byte Base64 secret, supplied only on the server.
# Keep in a secret manager or a root-readable environment file, with a separate protected backup.
POCKETMM_DATA_ENCRYPTION_KEY=
# Empty disables all operator searches/decryption. Comma-separated exact login IDs plus ADMIN/DEVELOPER role.
POCKETMM_PRIVATE_DATA_OPERATORS=
# Persistent images stay outside /opt/pocketmm so release replacement preserves them.
POCKET_BACKGROUND_DIRECTORY=/var/lib/pocketmm/backgrounds
POCKET_BACKGROUND_ENABLED=true
POCKET_BACKGROUND_MODEL=gemini-3.1-flash-lite-image
