# Add these overrides to /etc/pocketmm/pocketmm.env for MariaDB RDS.
# Preserve real secrets on the server when replacing the JAR.
# Current MySQL Connector/J release otherwise queries MariaDB's missing RESERVED column.
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MariaDBDialect
SPRING_JPA_PROPERTIES_HIBERNATE_BOOT_ALLOW_JDBC_METADATA_ACCESS=false
# Replace HOST with the RDS endpoint. The current RDS requires SSL.
PROD_DB_URL=jdbc:mysql://HOST:3306/pocketmm?sslMode=REQUIRED&characterEncoding=UTF-8
PROD_DB_USERNAME=pocketmm_app
PROD_DB_PASSWORD=
