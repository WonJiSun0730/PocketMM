[Unit]
Description=PocketMM Spring Boot
After=network-online.target redis6.service
Wants=network-online.target

[Service]
Type=simple
User=pocketmm
Group=pocketmm
WorkingDirectory=/opt/pocketmm
StateDirectory=pocketmm
Environment=POCKET_BACKGROUND_DIRECTORY=/var/lib/pocketmm/backgrounds
EnvironmentFile=/etc/pocketmm/pocketmm.env
ExecStart=/usr/bin/java -Xms128m -Xmx384m -jar /opt/pocketmm/pocketmm.jar
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
SuccessExitStatus=143
UMask=0077

[Install]
WantedBy=multi-user.target
